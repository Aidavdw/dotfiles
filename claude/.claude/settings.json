{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git shortlog *)",
      "Bash(git describe *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git for-each-ref *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git cat-file *)",
      "Bash(git merge-base *)",
      "Bash(git name-rev *)",
      "Bash(git reflog show *)"
    ],
    "deny": [
      "Read(~/notes/**)",
      "Edit(~/notes/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Bash(secret-tool *)",
      "Bash(secret-tool)",
      "Edit(.git/**)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git clone *)",
      "Bash(git init *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git stash *)",
      "Bash(git branch *)",
      "Bash(git tag *)",
      "Bash(git remote *)",
      "Bash(git submodule *)",
      "Bash(git worktree *)",
      "Bash(git config *)",
      "Bash(git update-ref *)",
      "Bash(git update-index *)",
      "Bash(git symbolic-ref *)",
      "Bash(git reflog expire *)",
      "Bash(git reflog delete *)",
      "Bash(git notes *)",
      "Bash(git replace *)",
      "Bash(git bisect *)",
      "Bash(git sparse-checkout *)",
      "Bash(git gc *)",
      "Bash(git prune *)",
      "Bash(git repack *)",
      "Bash(git maintenance *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git clean *)",
      "Bash(git read-tree *)",
      "Bash(git write-tree *)",
      "Bash(git commit-tree *)",
      "Bash(git hash-object *)",
      "Bash(git fast-import *)",
      "Bash(git checkout-index *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git commit)"
    ],
    "excludedCommands": [
      "docker *"
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "filesystem": {
      "denyWrite": [
        "./.git/**"
      ]
    },
    "network": {
      "allowLocalBinding": true
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "auto",
  "env": {
    "GIT_OPTIONAL_LOCKS": "0"
  }
}
