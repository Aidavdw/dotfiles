{
  "env": {
    "GIT_OPTIONAL_LOCKS": "0"
  },
  "permissions": {
    "allow": [
      "Read(~/.cache/uv/**)",
      "Read(~/plans/**)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo run *)",
      "Bash(cargo doc *)",
      "Bash(cargo clippy *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git shortlog *)",
      "Bash(git describe *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git for-each-ref *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git cat-file *)",
      "Bash(git merge-base *)",
      "Bash(git name-rev *)",
      "Bash(git mv *)",
      "Bash(git check-ignore *)",
      "Bash(git reflog show *)"
    ],
    "deny": [
      "Read(~/notes/**)",
      "Edit(~/notes/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Bash(secret-tool *)",
      "Bash(secret-tool)",
      "Edit(.git/**)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rm *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git clone *)",
      "Bash(git init *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git stash *)",
      "Bash(git branch *)",
      "Bash(git tag *)",
      "Bash(git remote *)",
      "Bash(git submodule *)",
      "Bash(git worktree *)",
      "Bash(git config *)",
      "Bash(git update-ref *)",
      "Bash(git update-index *)",
      "Bash(git symbolic-ref *)",
      "Bash(git reflog expire *)",
      "Bash(git reflog delete *)",
      "Bash(git notes *)",
      "Bash(git replace *)",
      "Bash(git bisect *)",
      "Bash(git sparse-checkout *)",
      "Bash(git gc *)",
      "Bash(git prune *)",
      "Bash(git repack *)",
      "Bash(git maintenance *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git clean *)",
      "Bash(git read-tree *)",
      "Bash(git write-tree *)",
      "Bash(git commit-tree *)",
      "Bash(git hash-object *)",
      "Bash(git fast-import *)",
      "Bash(git checkout-index *)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(cargo add *)",
      "Bash(cargo remove *)",
      "Bash(git commit)"
    ],
    "defaultMode": "default"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "strictAllowlist": true,
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyWrite": [
        "~/**/.git/**"
      ],
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "~/polars",
        "~/dotfiles",
        "~/geopolars",
        "~/rs-geoarrow",
        "~/read-only-repos",
        "~/.cargo",
        "~/.rustup",
        "~/.cache/uv"
      ]
    },
    "excludedCommands": []
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "timeFormat": "auto",
  "theme": "auto",
  "editorMode": "vim",
  "autoScrollEnabled": true,
  "inputNeededNotifEnabled": true
}
