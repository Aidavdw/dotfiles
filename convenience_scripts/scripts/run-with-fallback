#!/bin/sh

for cmd in "$@"; do
    # Extract the program name (everything before the first space)
    program=${cmd%% *}

    if command -v "$program" >/dev/null 2>&1; then
        sh -c "$cmd"
        exit $?
    fi
done

message="None of the requested programs are available."

printf '%s\n' "$message" >&2
notify-send "Program launcher" "$message"

exit 1
