{
  "env": {
    "GIT_OPTIONAL_LOCKS": "0",
    "UV_CACHE_DIR": ".uv-cache",
    "UV_LINK_MODE": "copy",
    "UV_OFFLINE": "1"
  },
  "permissions": {
    "allow": [
      "Read(~/.cache/uv/**)",
      "Read(~/plans/**)",
      "Read(~/.claude/skills/**)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo run *)",
      "Bash(cargo doc *)",
      "Bash(cargo clippy *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git shortlog *)",
      "Bash(git describe *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git for-each-ref *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git cat-file *)",
      "Bash(git merge-base *)",
      "Bash(git name-rev *)",
      "Bash(git mv *)",
      "Bash(git check-ignore *)",
      "Bash(git bisect *)",
      "Bash(git hash-object *)",
      "Bash(git grep *)",
      "Bash(ruff *)",
      "Bash(dprint fmt *)",
      "Bash(make *)",
      "Bash(git reflog show *)"
    ],
    "deny": [
      "Read(~/notes/**)",
      "Edit(~/notes/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Bash(secret-tool *)",
      "Bash(secret-tool)",
      "Edit(.git/**)",
      "Bash(git rm *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git clone *)",
      "Bash(git init *)",
      "Bash(git restore *)",
      "Bash(git merge *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git remote *)",
      "Bash(git submodule *)",
      "Bash(git worktree *)",
      "Bash(git config *)",
      "Bash(git update-ref *)",
      "Bash(git update-index *)",
      "Bash(git symbolic-ref *)",
      "Bash(git reflog expire *)",
      "Bash(git reflog delete *)",
      "Bash(git notes *)",
      "Bash(git replace *)",
      "Bash(git sparse-checkout *)",
      "Bash(git gc *)",
      "Bash(git prune *)",
      "Bash(git repack *)",
      "Bash(git maintenance *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git clean *)",
      "Bash(git read-tree *)",
      "Bash(git write-tree *)",
      "Bash(git commit-tree *)",
      "Bash(git fast-import *)",
      "Bash(git checkout-index *)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(cargo add *)",
      "Bash(cargo remove *)",
      "Bash(git cherry-pick *)",
      "Bash(git rebase *)",
      "Bash(git branch *)",
      "Bash(git commit)",
      "Bash(git switch *)",
      "Bash(git checkout *)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:domain-modeling": "off",
    "anthropic-skills:downloading-from-s3": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:polars-brand-colors": "off",
    "anthropic-skills:setup-aws": "off",
    "anthropic-skills:skill-creator": "off"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.rs) d=$(dirname \"$f\"); ed=; while [ -z \"$ed\" ] && [ \"$d\" != / ]; do [ -f \"$d/Cargo.toml\" ] && ed=$(sed -nE 's/^[[:space:]]*edition[[:space:]]*=[[:space:]]*\"([0-9]+)\".*/\\1/p' \"$d/Cargo.toml\" | head -n1); d=$(dirname \"$d\"); done; rustfmt ${ed:+--edition \"$ed\"} \"$f\";; *.py|*.pyi) ruff format --quiet \"$f\";; esac 2>/dev/null; true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/claude-notify.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/claude-notify.sh",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/claude-notify.sh",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/claude-notify.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "strictAllowlist": true,
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/repos/rs-dicts",
        "~/repos/rs-dicts/.git"
      ],
      "denyWrite": [
        "~/**/.git/**"
      ],
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "~/polars",
        "~/dotfiles",
        "~/geopolars",
        "~/rs-geoarrow",
        "~/read-only-repos",
        "~/.cargo",
        "~/.rustup",
        "~/.cache/uv",
        "~/.gitconfig",
        "~/.claude/skills"
      ]
    },
    "excludedCommands": []
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "timeFormat": "auto",
  "theme": "auto",
  "editorMode": "vim",
  "autoScrollEnabled": true,
  "inputNeededNotifEnabled": true
}
